<LinearLayout android:orientation="horizontal" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <ImageView android:id="@+id/widget_house_icon"
        android:layout_width="19dp" android:layout_height="19dp" android:layout_marginEnd="7dp"
        android:src="@drawable/ic_climate_greenhouse" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_title" style="@style/WidgetCaption"
        android:layout_width="0dp" android:layout_weight="1" android:textSize="18sp" android:textStyle="bold"
        android:textColor="@color/climate_primary" android:text="@string/app_name" />
    <TextView android:id="@+id/widget_status" style="@style/WidgetCaption"
        android:layout_width="wrap_content" android:layout_marginStart="6dp" android:fontFamily="sans-serif-medium" />
</LinearLayout>
