<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_body" style="@style/WidgetBody">
    <include layout="@layout/climate_widget_header" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:layout_marginBottom="8dp" android:orientation="horizontal">
        <include layout="@layout/climate_widget_tiles"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="47" />
        <include layout="@layout/climate_widget_chart"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="53"
            android:layout_marginStart="6dp" />
    </LinearLayout>
    <include layout="@layout/climate_widget_strip_footer" />
</LinearLayout>
