<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_body" style="@style/WidgetBody">
    <include layout="@layout/climate_widget_header" />
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginVertical="8dp">
        <include layout="@layout/climate_widget_tiles" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <include layout="@layout/climate_widget_chart" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight=".9"
            android:layout_marginStart="16dp" />
    </LinearLayout>
    <include layout="@layout/climate_widget_metadata" />
    <include layout="@layout/climate_widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
</LinearLayout>
