<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/climate_divider" android:orientation="horizontal" />
    <LinearLayout android:id="@+id/widget_strip_details" android:orientation="horizontal" android:gravity="center_vertical"
        android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp">
        <LinearLayout android:id="@+id/widget_health_group" android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.16">
            <ImageView android:id="@+id/widget_health_icon" android:layout_width="11dp" android:layout_height="11dp"
                android:layout_marginEnd="3dp" android:src="@drawable/ic_climate_check_circle" android:importantForAccessibility="no" />
            <TextView android:id="@+id/widget_health" style="@style/WidgetStripLabel" android:layout_width="wrap_content"
                android:textColor="@color/climate_secondary" android:maxLines="2" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_health_separator" style="@style/WidgetStripDivider" />
        <LinearLayout style="@style/WidgetStripMeta">
            <TextView android:id="@+id/widget_outside_label" style="@style/WidgetStripLabel" android:textAllCaps="true"
                android:text="@string/widget_outside" />
            <TextView android:id="@+id/widget_outside" style="@style/WidgetStripValue" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetStripDivider" />
        <LinearLayout style="@style/WidgetStripMeta">
            <TextView android:id="@+id/widget_target_label" style="@style/WidgetStripLabel" android:textAllCaps="true"
                android:text="@string/widget_target" />
            <TextView android:id="@+id/widget_target" style="@style/WidgetStripValue" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetStripDivider" />
        <LinearLayout style="@style/WidgetStripMeta">
            <TextView android:id="@+id/widget_dew_point_label" style="@style/WidgetStripLabel" android:textAllCaps="true"
                android:text="@string/widget_dew_point" />
            <TextView android:id="@+id/widget_dew_point" style="@style/WidgetStripValue" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetStripDivider" />
        <TextView android:id="@+id/widget_time" style="@style/WidgetStripLabel" android:layout_width="0dp"
            android:layout_weight="1.06" android:layout_marginStart="3dp" android:maxLines="2" android:gravity="end" />
    </LinearLayout>
</LinearLayout>
