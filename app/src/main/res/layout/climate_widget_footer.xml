<LinearLayout android:orientation="horizontal" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <ImageView android:id="@+id/widget_health_icon" android:layout_width="14dp" android:layout_height="14dp"
        android:layout_marginEnd="4dp" android:src="@drawable/ic_climate_check_circle" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_health" style="@style/WidgetCaption" android:layout_width="wrap_content" />
    <TextView android:id="@+id/widget_time" style="@style/WidgetCaption" android:layout_width="0dp" android:layout_weight="1"
        android:layout_marginStart="3dp" android:textColor="@color/climate_muted" android:gravity="end" />
</LinearLayout>
