<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_body"
    android:orientation="vertical" android:padding="12dp"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_surface">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_notification_greenhouse" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_title" style="@style/WidgetCaption"
            android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp"
            android:text="@string/app_name" android:textSize="14sp" android:textColor="#EFEEEB" />
        <TextView android:id="@+id/widget_period" style="@style/WidgetCaption"
            android:layout_width="wrap_content" android:layout_marginStart="4dp"
            android:text="@string/widget_trend" android:textSize="10sp" android:textColor="#C0C5CE" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_temperature_column"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:gravity="center_vertical"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.40">
            <TextView android:id="@+id/widget_temperature_label" style="@style/WidgetCaption"
                android:layout_height="0dp" android:layout_weight=".4" android:gravity="bottom"
                android:text="@string/widget_temperature" android:textColor="#FFC072" />
            <TextView android:id="@+id/widget_temperature" style="@style/WidgetValue"
                android:layout_height="0dp" android:layout_weight=".6" android:gravity="top"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:gravity="center_vertical"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.60">
            <ImageView android:id="@+id/widget_temperature_plot"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:scaleType="fitCenter" />
            <TextView android:id="@+id/widget_temperature_range" style="@style/WidgetCaption"
                android:gravity="end" android:paddingBottom="3dp" android:textSize="10sp" android:textColor="#A5B1B8" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_divider" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="1dp" android:background="#33383C" />
    <LinearLayout android:id="@+id/widget_humidity_column"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:gravity="center_vertical"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.40">
            <TextView android:id="@+id/widget_humidity_label" style="@style/WidgetCaption"
                android:layout_height="0dp" android:layout_weight=".4" android:gravity="bottom"
                android:text="@string/widget_humidity" android:textColor="#77D2EC" />
            <TextView android:id="@+id/widget_humidity" style="@style/WidgetValue"
                android:layout_height="0dp" android:layout_weight=".6" android:gravity="top"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:gravity="center_vertical"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.60">
            <ImageView android:id="@+id/widget_humidity_plot"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:scaleType="fitCenter" />
            <TextView android:id="@+id/widget_humidity_range" style="@style/WidgetCaption"
                android:gravity="end" android:paddingBottom="3dp" android:textSize="10sp" android:textColor="#A5B1B8" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_time" style="@style/WidgetCaption" android:layout_marginTop="2dp"
        android:textColor="#A5B1B8" android:textSize="10sp" />
</LinearLayout>
